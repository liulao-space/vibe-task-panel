# Vibe Task Panel LLM 配置模板
# 复制本文件为 .vibe-task-panel/.env 或项目根 .env，填入真实 key 即可

# 方式一（推荐）：deepseek 云 API，OpenAI 兼容，稳定不依赖本地
VTP_LLM=deepseek
DEEPSEEK_API_KEY=sk-在这里填你的key
# DEEPSEEK_MODEL=deepseek-chat

# 方式二：任意 OpenAI 兼容 API（如你 opencode 里已有的 provider / 中转站）
# VTP_LLM=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-xxx
# OPENAI_MODEL=gpt-4o-mini

# 方式三：本地 ollama（可选，卸载不影响上面的云 API）
# VTP_LLM=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=gemma4:e4b-mlx
